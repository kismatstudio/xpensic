{
  "name": "xpensic-server",
  "version": "1.0.0",
  "description": "Tiny auth + per-user data backend for XPENSIC. Pairs with the static client in the parent directory.",
  "private": true,
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "smoke": "node tests/smoke.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy -c wrangler.production.toml",
    "dev:worker": "wrangler dev",
    "dev:worker:prod": "wrangler dev -c wrangler.production.toml"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "license": "UNLICENSED"
}
