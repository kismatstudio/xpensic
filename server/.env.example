# XPENSIC server — local secrets template.
#
# Copy this file to `.env` (same directory) and fill in the values.
# The server reads `.env` automatically on boot; existing shell
# exports take precedence over the file. Do NOT commit `.env`.

# --- Required for real OTP delivery via Resend ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# --- Optional ---
# "From" address shown on the OTP email. Default if unset:
#   "XPENSIC <onboarding@resend.dev>"
# In production use a verified sender on your own domain, e.g.
#   "XPENSIC <no-reply@your-domain.com>"
# RESEND_FROM="XPENSIC <no-reply@your-domain.com>"

# --- Other env vars the server recognises (all optional) ---
# PORT=8787
# JWT_SECRET=change-me-in-production
# DB_PATH=expense-tracker.db.json
# NODE_ENV=development