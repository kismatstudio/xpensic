{
  "name": "xpensic",
  "version": "1.0.0",
  "description": "XPENSIC — a lightweight expense tracker that runs entirely in the browser. No build step, no backend, no install.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev-server.cjs",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File dev-server-start.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File dev-server-stop.ps1",
    "logs": "node -e \"require('node:fs').createReadStream('dev-server.log',{encoding:'utf8'}).on('data',c=>process.stdout.write(c)).on('end',()=>{})\"",
    "test": "node tests/run-all.mjs",
    "test:bail": "node tests/run-all.mjs --bail"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "expense-tracker",
    "budget",
    "vanilla-js",
    "no-build"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "libsodium-wrappers": "^0.7.16",
    "libsodium-wrappers-sumo": "^0.7.16",
    "resend": "^6.24.0"
  }
}
