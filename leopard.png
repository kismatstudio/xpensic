
    <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96">
      <defs>
        <!-- Primary background: top-light to bottom-shadow radial gradient -->
        <radialGradient id="g_animal_leopard" cx="35%" cy="28%" r="78%">
          <stop offset="0" stop-color="#fef3c7" stop-opacity="0.55"/>
          <stop offset="0.45" stop-color="#e8a020"/>
          <stop offset="1" stop-color="#3b2412"/>
        </radialGradient>
        <!-- Studio key-light overlay (soft, almost-white) -->
        <radialGradient id="lt_animal_leopard" cx="35%" cy="25%" r="55%">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.45"/>
          <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.12"/>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
        </radialGradient>
        <!-- Rim-light halo around the character -->
        <radialGradient id="rm_animal_leopard" cx="50%" cy="55%" r="50%">
          <stop offset="0.6" stop-color="#ffffff" stop-opacity="0"/>
          <stop offset="0.85" stop-color="#ffffff" stop-opacity="0.25"/>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
        </radialGradient>
        <!-- Vignette: dark corners, transparent centre -->
        <radialGradient id="vg_animal_leopard" cx="50%" cy="50%" r="65%">
          <stop offset="0.55" stop-color="#000000" stop-opacity="0"/>
          <stop offset="1" stop-color="#000000" stop-opacity="0.35"/>
        </radialGradient>
        <!-- Soft drop shadow so the character pops off the background -->
        <filter id="ds_animal_leopard" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="1.2"/>
          <feOffset dx="0" dy="0.8" result="off"/>
          <feComponentTransfer in="off" result="shadow">
            <feFuncA type="linear" slope="0.45"/>
          </feComponentTransfer>
          <feMerge>
            <feMergeNode in="shadow"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
      </defs>
      <!-- Layer 1: gradient base -->
      <rect width="96" height="96" rx="48" fill="url(#g_animal_leopard)"/>
      <!-- Layer 2: studio key-light highlight -->
      <rect width="96" height="96" rx="48" fill="url(#lt_animal_leopard)"/>
      <!-- Layer 3: the character with a subtle drop shadow -->
      <g filter="url(#ds_animal_leopard)"><path d="M 32 24 Q 48 20 64 24" stroke="#ffffff" stroke-width="1.6" fill="none" stroke-linecap="round" opacity="0.55"/><path d="M 39.6 24.3 Q 40.3 23.2 43.1 22.8" stroke="#3b2412" stroke-width="0.5" fill="none" stroke-linecap="round" opacity="0.6"/><path d="M 46.6 23.6 Q 47.3 22.4 50.1 22.2" stroke="#3b2412" stroke-width="0.5" fill="none" stroke-linecap="round" opacity="0.6"/><path d="M 53.6 24.2 Q 55.7 23.4 57.8 23.6" stroke="#3b2412" stroke-width="0.5" fill="none" stroke-linecap="round" opacity="0.6"/><circle cx="32" cy="20" r="8" fill="#e8a020"/><circle cx="64" cy="20" r="8" fill="#e8a020"/><circle cx="32" cy="20" r="4" fill="#3b2412" opacity="0.6"/><circle cx="64" cy="20" r="4" fill="#3b2412" opacity="0.6"/><ellipse cx="48" cy="40" rx="24" ry="22" fill="#e8a020"/><g fill="#3b2412" opacity="0.55"><circle cx="34" cy="32" r="2.5"/><circle cx="42" cy="26" r="2"/><circle cx="54" cy="26" r="2"/><circle cx="62" cy="32" r="2.5"/><circle cx="32" cy="50" r="2.5"/><circle cx="64" cy="50" r="2.5"/><circle cx="40" cy="58" r="2"/><circle cx="56" cy="58" r="2"/><circle cx="48" cy="22" r="1.5"/></g><ellipse cx="48" cy="48" rx="12" ry="8" fill="#fef3c7"/><ellipse cx="48" cy="46" rx="3" ry="2" fill="#3b2412"/><path d="M48 48 L48 52 M48 52 Q44 54 42 52 M48 52 Q52 54 54 52" stroke="#3b2412" stroke-width="1.2" fill="none" stroke-linecap="round"/><ellipse cx="40" cy="36" rx="5" ry="3.5" fill="#fef3c7"/><ellipse cx="56" cy="36" rx="5" ry="3.5" fill="#fef3c7"/><ellipse cx="40" cy="36" rx="1.5" ry="2.8" fill="#1a6b3a"/><ellipse cx="56" cy="36" rx="1.5" ry="2.8" fill="#1a6b3a"/><circle cx="41" cy="35" r="0.9" fill="#ffffff"/><circle cx="57" cy="35" r="0.9" fill="#ffffff"/><path d="M34 30 L42 32" stroke="#3b2412" stroke-width="1.5" stroke-linecap="round"/><path d="M62 30 L54 32" stroke="#3b2412" stroke-width="1.5" stroke-linecap="round"/><ellipse cx="32" cy="46" rx="3" ry="1.8" fill="#f4a8b8" opacity="0.5"/><ellipse cx="64" cy="46" rx="3" ry="1.8" fill="#f4a8b8" opacity="0.5"/><defs><linearGradient id="g_growth" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#166534"/><stop offset="1" stop-color="#4ade80"/></linearGradient></defs><rect x="12" y="84.5" width="4" height="0.6" rx="0.3" fill="#0a3a1a" opacity="0.5"/><rect x="17" y="84.5" width="4" height="0.6" rx="0.3" fill="#0a3a1a" opacity="0.5"/><rect x="22" y="84.5" width="4" height="0.6" rx="0.3" fill="#0a3a1a" opacity="0.5"/><rect x="27" y="84.5" width="4" height="0.6" rx="0.3" fill="#0a3a1a" opacity="0.5"/><rect x="12" y="78" width="4" height="6" rx="0.5" fill="url(#g_growth)"/><rect x="17" y="74" width="4" height="10" rx="0.5" fill="url(#g_growth)"/><rect x="22" y="70" width="4" height="14" rx="0.5" fill="url(#g_growth)"/><rect x="27" y="64" width="4" height="20" rx="0.5" fill="url(#g_growth)"/><rect x="12" y="78" width="4" height="1.2" rx="0.5" fill="#86efac" opacity="0.7"/><rect x="17" y="74" width="4" height="1.2" rx="0.5" fill="#86efac" opacity="0.7"/><rect x="22" y="70" width="4" height="1.2" rx="0.5" fill="#86efac" opacity="0.7"/><rect x="27" y="64" width="4" height="1.2" rx="0.5" fill="#86efac" opacity="0.7"/><path d="M14 76 L28 60" stroke="#fbbf24" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.4" stroke-width="4"/><path d="M14 76 L28 60" stroke="#fbbf24" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M28 60 L24 60 L28 60 L28 64" stroke="#fbbf24" stroke-width="1.5" fill="none" stroke-linecap="round"/><circle cx="28" cy="60" r="1.4" fill="#fef3c7"/><circle cx="28" cy="60" r="0.7" fill="#ffffff"/></g>
      <!-- Layer 4: rim-light halo (over character) -->
      <rect width="96" height="96" rx="48" fill="url(#rm_animal_leopard)"/>
      <!-- Layer 5: vignette to darken corners -->
      <rect width="96" height="96" rx="48" fill="url(#vg_animal_leopard)"/>
      <!-- Chest emblem: white pill with the first letter -->
      <circle cx="48" cy="86" r="9.5" fill="#0a0f18" opacity="0.35"/>
      <circle cx="48" cy="86" r="9" fill="#ffffff"/>
      <circle cx="48" cy="86" r="9" fill="none" stroke="#fef3c7" stroke-width="0.5" opacity="0.6"/>
      <text x="48" y="89" text-anchor="middle"
            font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
            font-size="11" font-weight="800" fill="#3b2412" opacity="0.55">L</text>
      <text x="48" y="88.5" text-anchor="middle"
            font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
            font-size="11" font-weight="800" fill="#e8a020">L</text>
    </svg>